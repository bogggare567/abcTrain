build/
build-*/
cmake-build-*/
.DS_Store
*.xcodeproj
*.xcworkspace
.vs/
out/

# Local test audio. Never committed - see decisions/025.
#
# The project is tested against real music, because the slicer's
# classifier was technically correct and practically useless until it was
# run over actual records (a full mix has several onsets a second, so
# onset density alone called everything percussive). That material is the
# developer's own and stays on the developer's machine: it is test input,
# not a project asset, and shipping it would be redistribution whatever
# the excerpt length.
/audio/
/test-audio/
*.wav
!assets/samples/**/*.wav

# Working notes from an audit pass. Findings live in the commit
# messages, which cannot drift; a snapshot of "what is broken" goes stale
# the moment it is acted on.
/audit/

# Font sources, re-downloadable; see tools/build_fonts.py
tools/.fontcache/

# The full screen gallery (ADR 039). tools/EditorSnapshots renders every
# screen in both themes into editor-snapshots/ by default - about 30 MB a
# pass, and committing it grew the repository by that much every time the
# look changed. Only the images a page actually shows (README, wiki, the
# website brief) live in docs/screenshots/; render the rest when you need
# to look.
/editor-snapshots/

# Python bytecode from tools/library and its tests
__pycache__/
