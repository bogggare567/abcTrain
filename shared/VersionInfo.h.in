#pragma once

// Generated by CMake (see the "Version from git describe" block in the
// root CMakeLists.txt) - not committed, not hand-edited. shared/Version.h
// is the hand-maintained file that actually gets #included elsewhere;
// this is just where the raw git-derived strings come from.
namespace VersionInfo
{
    constexpr const char* versionString = "@ABCTRAIN_VERSION_STRING@";
    constexpr const char* gitDescribe = "@ABCTRAIN_GIT_DESCRIBE@";

    // The city this release line is named after (shared/updates/release-names.txt),
    // or empty for a line that has none (every release before 2.0).
    constexpr const char* codename = "@ABCTRAIN_CODENAME@";

    // Each part's own version, from versions.json (ADR 069).
    constexpr const char* learnerEQ   = "@ABCTRAIN_VERSION_LEARNER_EQ@";
    constexpr const char* learnerComp = "@ABCTRAIN_VERSION_LEARNER_COMP@";
    constexpr const char* learnerVerb = "@ABCTRAIN_VERSION_LEARNER_VERB@";
    constexpr const char* lessons     = "@ABCTRAIN_VERSION_LESSONS@";
}
